# GitHub repo where content is stored
HAGAKI_GITHUB_OWNER=your-org
HAGAKI_GITHUB_REPO=your-content-repo

# Personal access token / GitHub App token with write access to the repo
# Stored in Bitwarden Secrets Manager (project: morinoparty, key: hagaki/HAGAKI_GITHUB_TOKEN)
# and in Cloudflare Secrets Store as hagaki_HAGAKI_GITHUB_TOKEN for the deployed Worker,
# wired via `secrets_store_secrets` in wrangler.jsonc — NOT read from this file.
# For local `wrangler dev`, seed a local value with:
#   wrangler secrets-store secret create d36d5a11ea07462c83bb21a0e9ccb811 --name hagaki_HAGAKI_GITHUB_TOKEN --scopes workers
# HAGAKI_GITHUB_TOKEN=ghp_xxx

# Base URL for fetching published content JSON / markdown.
# content-worker をデプロイした URL を入れる (例: https://content-hagaki.<subdomain>.workers.dev)
HAGAKI_CDN_BASE_URL=https://content-hagaki.example.workers.dev

# Optional (defaults shown)
# HAGAKI_GITHUB_BRANCH=main
# HAGAKI_GITHUB_CONTENT_PATH=content/article
