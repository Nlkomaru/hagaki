# GitHub repo where content is stored
HAGAKI_GITHUB_OWNER=your-org
HAGAKI_GITHUB_REPO=your-content-repo

# Personal access token / GitHub App token with write access to the repo
HAGAKI_GITHUB_TOKEN=ghp_xxx

# Base URL for fetching published content JSON / markdown.
# content-worker をデプロイした URL を入れる (例: https://content-hagaki.<subdomain>.workers.dev)
HAGAKI_CDN_BASE_URL=https://content-hagaki.example.workers.dev

# Optional (defaults shown)
# HAGAKI_GITHUB_BRANCH=main
# HAGAKI_GITHUB_CONTENT_PATH=content/wiki
