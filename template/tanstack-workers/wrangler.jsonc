/**
 * Wrangler config for the TanStack Start app deployed to Cloudflare Workers.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "hagaki-template",
    "main": "@tanstack/react-start/server-entry",
    "compatibility_date": "2025-12-13",
    "compatibility_flags": ["nodejs_compat_v2", "global_fetch_strictly_public"],
    "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client"
    },
    "observability": {
        "enabled": true
    },
    "preview_urls": true,
    "vars": {
        "HAGAKI_CDN_BASE_URL": "https://content-hagaki.nikomaru.workers.dev",
        "HAGAKI_GITHUB_OWNER": "nlkomaru",
        "HAGAKI_GITHUB_REPO": "hagaki-content",
        // MineAuth (OIDC) — public client + PKCE。client secret は不要。
        // このアプリの origin の redirect URI
        // (`<origin>/api/auth/oauth2/callback/MineAuth`) を登録した
        // client の ID に差し替えること。
        "CLIENT_ID": "set-your-mineauth-client-id",
        "MAIN_SERVER_URL": "https://api.morino.party/main"
        // 非機密値はここに置けるが、HAGAKI_GITHUB_TOKEN は secret として
        // `wrangler secret put HAGAKI_GITHUB_TOKEN` で設定すること。
        // 機密でない値の例:
        // "HAGAKI_GITHUB_OWNER": "your-org",
        // "HAGAKI_GITHUB_REPO": "your-content-repo",
        // "HAGAKI_GITHUB_BRANCH": "main",
        // "HAGAKI_GITHUB_CONTENT_PATH": "content/wiki",
        // "HAGAKI_CDN_BASE_URL": "https://content-hagaki.<subdomain>.workers.dev"
    },
    // HAGAKI_GITHUB_TOKEN は Cloudflare Secrets Store (BSM: hagaki/HAGAKI_GITHUB_TOKEN)、
    // AUTH_SECRET は同 (BSM: shared/AUTH_SECRET) から供給する
    "secrets_store_secrets": [
        {
            "binding": "HAGAKI_GITHUB_TOKEN",
            "store_id": "d36d5a11ea07462c83bb21a0e9ccb811",
            "secret_name": "hagaki_HAGAKI_GITHUB_TOKEN"
        },
        {
            "binding": "AUTH_SECRET",
            "store_id": "d36d5a11ea07462c83bb21a0e9ccb811",
            "secret_name": "shared_AUTH_SECRET"
        }
    ]
}
